# One public origin for the services (see README, "Deployment behind Caddy").
# `localhost` works as is for a local try-out: Caddy issues a certificate from its own local CA.
# For a real deployment set ME_HOST to the hostname, e.g. `ME_HOST=me.example.com caddy run`.
{$ME_HOST:localhost} {
	# auth-web's own page that finishes a social sign-in. It lives under /social/, so it is
	# listed before the /social/* rule that sends everything else there to auth-service.
	handle /social/complete {
		reverse_proxy 127.0.0.1:5080
	}

	# auth-service: the OAuth 2 / OpenID Connect endpoints and the social sign-in redirects.
	handle /oauth/* {
		reverse_proxy 127.0.0.1:8081
	}
	# CalDAV clients look for the calendar home here; send them to caldav-bridge's root.
	handle /.well-known/caldav {
		redir /dav/ 301
	}
	handle /.well-known/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle /social/* {
		reverse_proxy 127.0.0.1:8081
	}

	# calendar-service's API description and its documentation page, published so that they can be
	# read from other machines while the project is in development. Neither asks for a sign-in; they
	# show the shape of the API, no data. Remove these two blocks to keep them internal. Listed
	# before the /calendar/* rule, which would otherwise send them to the service as they are.
	handle /calendar/openapi.json {
		rewrite * /api/openapi.json
		reverse_proxy 127.0.0.1:8083
	}
	handle /calendar/docs {
		rewrite * /api/docs
		reverse_proxy 127.0.0.1:8083
	}

	# calendar-service: the public API. The two headers are how internal callers identify themselves,
	# so a client must not be able to send them.
	handle /calendar/* {
		reverse_proxy 127.0.0.1:8083 {
			header_up -X-Service-Secret
			header_up -X-User-Id
		}
	}

	# tasks-service's API description and its documentation page, published so that they can be
	# read from other machines while the project is in development. Neither asks for a sign-in; they
	# show the shape of the API, no data. Remove these two blocks to keep them internal. Listed
	# before the /tasks/* rule, which would otherwise send them to the service as they are.
	handle /tasks/openapi.json {
		rewrite * /api/openapi.json
		reverse_proxy 127.0.0.1:8084
	}
	handle /tasks/docs {
		rewrite * /api/docs
		reverse_proxy 127.0.0.1:8084
	}

	# tasks-service: the public API. The two headers are how internal callers identify themselves,
	# so a client must not be able to send them.
	handle /tasks/* {
		reverse_proxy 127.0.0.1:8084 {
			header_up -X-Service-Secret
			header_up -X-User-Id
		}
	}

	# caldav-bridge: CalDAV for clients such as Thunderbird. It takes no service secret and the headers
	# above mean nothing to it; it reads Caddy's own X-Forwarded-For. `/dav` is listed apart from
	# `/dav/*`, which does not match it.
	# The bridge trusts the address Caddy sets: the last entry of that header is what it passes on.
	handle /dav {
		reverse_proxy 127.0.0.1:8085
	}
	handle /dav/* {
		reverse_proxy 127.0.0.1:8085
	}

	# The services' /api/* is the internal API (guarded only by the shared service secret) and its
	# documentation page. It is never proxied; auth-web has no /api/ routes either, so answer here.
	handle /api/* {
		respond 404
	}

	# Everything else: auth-web (pages, static files, the Blazor WebSocket).
	handle {
		reverse_proxy 127.0.0.1:5080
	}
}

<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">
  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <!-- LOG_FORMAT=json selects the JSON target; anything else the coloured one. -->
    <target xsi:type="ColoredConsole" name="pretty" useDefaultRowHighlightingRules="true"
            layout="${date:format=HH\:mm\:ss.fff} ${level:uppercase=true:padding=-5} ${logger:shortName=true} [${scopeproperty:RequestId}] ${message}${onexception:inner= ${exception:format=tostring}}" />
    <target xsi:type="Console" name="json">
      <layout xsi:type="JsonLayout" includeScopeProperties="false">
        <attribute name="time" layout="${date:format=o}" />
        <attribute name="level" layout="${level:lowercase=true}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
        <attribute name="properties" encode="false">
          <layout xsi:type="JsonLayout" includeEventProperties="true" maxRecursionLimit="1" />
        </attribute>
        <attribute name="RequestId" layout="${scopeproperty:RequestId}" />
        <attribute name="exception" layout="${exception:format=tostring}" />
      </layout>
    </target>
  </targets>

  <rules>
    <!-- Framework chatter at Warning; the HttpClient loggers would print request URLs (which hold challenges). -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="pretty">
      <filters defaultAction="Log">
        <when condition="'${environment:LOG_FORMAT}' == 'json'" action="Ignore" />
      </filters>
    </logger>
    <logger name="*" minlevel="Info" writeTo="json">
      <filters defaultAction="Ignore">
        <when condition="'${environment:LOG_FORMAT}' == 'json'" action="Log" />
      </filters>
    </logger>
  </rules>
</nlog>

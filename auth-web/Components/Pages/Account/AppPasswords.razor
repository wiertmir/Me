@page "/account/app-passwords"
@rendermode InteractiveServer
@attribute [Authorize]
@inherits ApiComponent

<PageTitle>App passwords</PageTitle>
<h1>App passwords</h1>
<p>Use an app password to connect calendar and task apps that can't sign in through the browser.</p>

@if (secret is not null)
{
    <SecretPanel Title="@($"New app password for {secretLabel}")" Secret="@secret" OnDismiss="Dismiss" />
}

<h2>Create an app password</h2>
<form @onsubmit="Create" @onsubmit:preventDefault>
    <p>
        <label for="label">Label</label>
        <input id="label" @bind="label" maxlength="64" required aria-describedby="label-hint" />
        <span id="label-hint" class="hint">For example the app's name.</span>
    </p>
    <button type="submit">Create app password</button>
    <span role="alert" class="error">@createError</span>
</form>

<h2>Your app passwords</h2>
<div role="status">@notice</div>
<div role="alert" class="error">@error</div>
@if (failed) { <LoadFailed What="your app passwords" OnRetry="Load" /> }
else if (items is null) { <p>Loading…</p> }
else if (items.Count == 0) { <p>No app passwords yet.</p> }
else
{
    <table>
        <caption>App passwords</caption>
        <thead><tr><th scope="col">Label</th><th scope="col">Created</th><th scope="col">Last used</th><th scope="col">Actions</th></tr></thead>
        <tbody>
        @foreach (var p in items)
        {
            <tr>
                <th scope="row">@p.Label</th>
                <td><Time Value="p.CreatedAt" /></td>
                <td>@if (p.LastUsed is null) { <text>Never used</text> } else { <Time Value="p.LastUsed" /> }</td>
                <td><button type="button" @onclick="() => AskDelete(p)">Delete<span class="visually-hidden"> app password @p.Label</span></button></td>
            </tr>
        }
        </tbody>
    </table>
}

<ConfirmDialog Request="pending" OnDone="() => pending = null" />

@code {
    private List<AppPasswordInfo>? items;
    private bool failed;
    private string label = "";
    private string? secret, secretLabel, createError, notice, error;
    private ConfirmRequest? pending;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        failed = false;
        var r = await Call(t => Api.AppPasswords(t));
        if (r is null) return;
        if (r.Ok) items = r.Value; else failed = true;
    }

    private async Task Create()
    {
        createError = null;
        var name = label.Trim();
        if (name.Length == 0) { createError = "Enter a label."; return; }
        var r = await Call(t => Api.CreateAppPassword(t, name));
        if (r is null) return;
        if (!r.Ok) { createError = Describe(r); return; }
        secret = r.Value!.Password; // component state only; cleared on dismiss
        secretLabel = r.Value.Label;
        label = "";
        await Load();
    }

    private void Dismiss() { secret = null; secretLabel = null; }

    private void AskDelete(AppPasswordInfo p) =>
        pending = new($"Delete the app password \"{p.Label}\"? Apps using it will stop working.", "Delete", () => Delete(p));

    private async Task Delete(AppPasswordInfo p)
    {
        notice = error = null;
        var r = await Call(t => Api.DeleteAppPassword(t, p.Id));
        if (r is null) return;
        if (r.Ok) notice = $"Deleted app password {p.Label}."; else error = Describe(r);
        await Load();
    }
}

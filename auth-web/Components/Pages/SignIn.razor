@page "/signin"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@inherits SsrPage
@inject ILogger<SignIn> Logger

<PageTitle>Sign in</PageTitle>
<h1>Sign in</h1>

@if (Notice == "reset") { <p role="status">Password changed. Sign in with your new password.</p> }

<form method="post" action="/signin@(CarryQuery(Challenge, ReturnUrl))" @onsubmit="Submit" @formname="signin">
    <AntiforgeryToken />
    <div role="alert">@if (error is not null) { <p class="error">@error</p> }</div>
    <p>
        <label for="login">Username or email</label>
        <input id="login" name="Input.Login" type="text" value="@Input?.Login" autocomplete="username" required />
    </p>
    <p>
        <label for="password">Password</label>
        <input id="password" name="Input.Password" type="password" autocomplete="current-password" required />
    </p>
    <button type="submit">Sign in</button>
</form>

<ProviderButtons Challenge="@Challenge" />

@if (showResend)
{
    <h2>Verify your email</h2>
    <ResendForm Email="@(Input?.Login?.Contains('@') == true ? Input.Login : null)" />
}

<p>
    <a href="/signup@(CarryQuery(Challenge, ReturnUrl))">Create an account</a>
    · <a href="/forgot@(CarryQuery(Challenge, ReturnUrl))">Forgot password?</a>
</p>

@code {
    [SupplyParameterFromQuery] private string? Challenge { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? Notice { get; set; }
    [SupplyParameterFromForm(FormName = "signin")] private SignInForm? Input { get; set; }

    private string? error;
    private bool showResend;

    // Fixed texts only: the query value is looked up, never echoed.
    private static readonly Dictionary<string, string> ErrorTexts = new()
    {
        ["social_failed"] = "Sign-in with that provider didn't complete. Please try again.",
        ["account_exists"] = "An account with that email already exists. Sign in with your password, then link the provider from your account.",
        ["signup_disabled"] = "Sign-up is not available.",
        ["account_disabled"] = "This account is disabled.",
        ["email_required"] = "That provider didn't share an email address, so we can't create an account.",
        ["provider_unavailable"] = "That sign-in provider isn't available.",
        ["email_not_verified"] = "Verify your email before signing in.",
    };

    private sealed class SignInForm
    {
        public string? Login { get; set; }
        public string? Password { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (!string.IsNullOrEmpty(Error))
        {
            error = ErrorTexts.GetValueOrDefault(Error, "Sign-in didn't complete. Please try again.");
            showResend = Error == "email_not_verified";
        }
        showResend |= Posted("resend");
        // Already signed in and arriving with a challenge: accept it without showing the form.
        if (HttpMethods.IsGet(HttpContext.Request.Method) && !string.IsNullOrEmpty(Challenge)
            && HttpContext.User.Identity?.IsAuthenticated == true && SessionToken is { } token)
        {
            var r = await Api.AcceptAuthRequest(token, Challenge);
            if (r.Ok) { Nav.NavigateTo(r.Value!.RedirectTo); return; }
            if (await Redirected(r)) return;
            error = Describe(r);
        }
    }

    private async Task Submit()
    {
        var r = await Api.SignIn(Input!.Login ?? "", Input.Password ?? "");
        if (!r.Ok)
        {
            if (await Redirected(r, userScoped: false)) return;
            Logger.LogWarning("Sign-in failed for {Login}: {Code}", LogText.Clean(Input.Login), r.Code);
            showResend = r.Code == "email_not_verified";
            error = r.Code switch
            {
                "invalid_credentials" => "Incorrect username, email or password.",
                "email_not_verified" => ErrorTexts["email_not_verified"],
                _ => Describe(r),
            };
            return;
        }
        await SessionPrincipal.SignIn(HttpContext, r.Value!.SessionToken, r.Value.User);
        Logger.LogInformation("Signed in {Username}", r.Value.User.Username);
        error = await Continue(r.Value.SessionToken, r.Value.User.MustChangePassword, Challenge, ReturnUrl);
    }
}

@page "/forgot"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@inherits SsrPage

<PageTitle>Forgot password</PageTitle>
<h1>Forgot password</h1>

<form method="post" @onsubmit="Submit" @formname="forgot">
    <AntiforgeryToken />
    <div role="alert">@if (error is not null) { <p class="error">@error</p> }</div>
    <div role="status">@if (sent) { <p>If an account exists for that address, we've sent a reset link.</p> }</div>
    <p>
        <label for="email">Email</label>
        <input id="email" name="Input.Email" type="email" autocomplete="email" required />
    </p>
    <button type="submit">Send reset link</button>
</form>

<p><a href="/signin@(CarryQuery(Challenge, ReturnUrl))">Back to sign in</a></p>

@code {
    [SupplyParameterFromQuery] private string? Challenge { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromForm(FormName = "forgot")] private ForgotForm? Input { get; set; }

    private string? error;
    private bool sent;

    private sealed class ForgotForm { public string? Email { get; set; } }

    protected override void OnInitialized()
    {
        Input ??= new();
        if (HttpContext.User.Identity?.IsAuthenticated == true) Nav.NavigateTo("/account");
    }

    private async Task Submit()
    {
        var r = await Api.ForgotPassword(Input!.Email ?? "");
        if (r.Code == "rate_limited") { error = Describe(r); return; }
        if (await Redirected(r, userScoped: false)) return;
        sent = true; // identical for known, unknown and malformed addresses
    }
}

@page "/verify"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@inherits SsrPage

<PageTitle>Confirm your email</PageTitle>
<h1>Confirm your email</h1>

@if (done)
{
    <p role="status">Email verified. You can sign in now.</p>
    <p><a href="/signin">Sign in</a></p>
}
else if (expired)
{
    <p role="alert">This link has expired or was already used.</p>
    <ResendForm />
}
else
{
    <form method="post" @onsubmit="Submit" @formname="verify">
        <AntiforgeryToken />
        <div role="alert">@if (error is not null) { <p class="error">@error</p> }</div>
        <input type="hidden" name="Input.Token" value="@Input?.Token" />
        <button type="submit">Confirm your email</button>
    </form>
}

@code {
    [SupplyParameterFromQuery] private string? Token { get; set; }
    [SupplyParameterFromForm(FormName = "verify")] private VerifyForm? Input { get; set; }

    private string? error;
    private bool done, expired;

    private sealed class VerifyForm { public string? Token { get; set; } }

    // GET only shows the button: mail scanners follow links, so verifying must be a POST.
    protected override void OnInitialized()
    {
        Input ??= new() { Token = Token };
        expired = Posted("resend") || string.IsNullOrEmpty(Input.Token);
    }

    private async Task Submit()
    {
        var r = await Api.VerifyEmail(Input!.Token ?? "");
        if (r.Ok) { done = true; return; }
        if (await Redirected(r, userScoped: false)) return;
        if (r.Code is "invalid_token" or "validation") expired = true;
        else error = Describe(r);
    }
}

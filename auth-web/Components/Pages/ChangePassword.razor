@page "/change-password"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize]
@layout AuthLayout
@inherits SsrPage
@inject ILogger<ChangePassword> Logger

<PageTitle>@Title</PageTitle>
<h1>@Title</h1>
@if (SessionPrincipal.MustChange(HttpContext.User)) { <p>Your password is temporary. Choose a new one to continue.</p> }
@if (hasPassword) { <p class="hint">Changing your password signs out your other devices and removes your app passwords.</p> }
else { <p class="hint">Your account has no password yet. Setting one signs out your other devices and removes your app passwords.</p> }

<form method="post" @onsubmit="Submit" @formname="change-password">
    <AntiforgeryToken />
    <div role="alert">@if (error is not null) { <p class="error">@error</p> }</div>
    @if (hasPassword)
    {
        <p>
            <label for="current">Current password</label>
            <input id="current" name="Input.Current" type="password" autocomplete="current-password" required
                   aria-describedby="@(currentError is null ? null : "current-error")" />
            @if (currentError is not null) { <span id="current-error" class="error">@currentError</span> }
        </p>
    }
    <p>
        <label for="new">New password</label>
        <input id="new" name="Input.New" type="password" autocomplete="new-password" required minlength="8"
               aria-describedby="@(newError is null ? "new-hint" : "new-hint new-error")" />
        <span id="new-hint" class="hint">At least 8 characters.</span>
        @if (newError is not null) { <span id="new-error" class="error">@newError</span> }
    </p>
    <p>
        <label for="confirm">Confirm new password</label>
        <input id="confirm" name="Input.Confirm" type="password" autocomplete="new-password" required
               aria-describedby="@(confirmError is null ? null : "confirm-error")" />
        @if (confirmError is not null) { <span id="confirm-error" class="error">@confirmError</span> }
    </p>
    <button type="submit">@Title</button>
</form>

<p><a href="/signout">Sign out instead</a></p>

@code {
    [SupplyParameterFromQuery] private string? Challenge { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromForm] private ChangeForm? Input { get; set; }

    private string? error, currentError, newError, confirmError;
    // False for an account created through social sign-in that never set a password: it sets its first one,
    // so there is no current password to ask for. The service decides; this only shapes the form.
    private bool hasPassword = true;

    private string Title => hasPassword ? "Change password" : "Set a password";

    private sealed class ChangeForm
    {
        public string? Current { get; set; }
        public string? New { get; set; }
        public string? Confirm { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (SessionToken is not { } token) return;
        var me = await Api.Me(token);
        if (me.Ok) hasPassword = me.Value!.HasPassword;
        else await Redirected(me);
    }

    private async Task Submit()
    {
        Input ??= new();
        if (SessionToken is not { } token) { Nav.NavigateTo("/signin"); return; }
        if (Input.New != Input.Confirm) { confirmError = "The passwords do not match."; return; }

        var r = await Api.ChangePassword(token, hasPassword ? Input.Current ?? "" : null, Input.New ?? "");
        if (!r.Ok)
        {
            if (await Redirected(r)) return;
            switch (r.Code)
            {
                case "invalid_credentials" when hasPassword: currentError = "The current password is incorrect."; break;
                case "invalid_credentials": error = "Your account now has a password. Reload this page and enter it."; break;
                case "validation": newError = r.Message; break;
                default: error = Describe(r); break;
            }
            return;
        }

        // Re-issue the cookie from the service's view of the user: the forced-change flag is now cleared.
        var me = await Api.Me(token);
        if (!me.Ok)
        {
            if (await Redirected(me)) return;
            error = Describe(me);
            return;
        }
        await SessionPrincipal.SignIn(HttpContext, token, me.Value!);
        Logger.LogInformation("Password changed for {Username}", me.Value!.Username);
        error = await Continue(token, me.Value.MustChangePassword, Challenge, ReturnUrl);
    }
}

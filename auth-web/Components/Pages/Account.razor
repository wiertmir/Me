@page "/account"
@rendermode InteractiveServer
@attribute [Authorize]
@inject AuthApi Api
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Account</PageTitle>
<h1>Account</h1>

@if (error is not null)
{
    <p role="alert" class="error">@error</p>
    <p><a href="/signin">Sign in</a></p>
}
else if (user is null)
{
    <p>Loading…</p>
}
else
{
    <dl>
        <dt>Username</dt><dd>@user.Username</dd>
        <dt>Display name</dt><dd>@user.DisplayName</dd>
        <dt>Email</dt><dd>@user.Email</dd>
        <dt>Email verified</dt><dd>@(user.EmailVerified ? "Yes" : "No")</dd>
        <dt>Administrator</dt><dd>@(user.IsAdmin ? "Yes" : "No")</dd>
    </dl>
    <p><a href="/signout">Sign out</a></p>
}

@code {
    private User? user;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        if (SessionPrincipal.Token(principal) is not { } token) { error = "You are not signed in."; return; }

        var r = await Api.Me(token);
        if (Nav.Handle(r)) return;
        if (r.Ok) user = r.Value; else error = r.Message;
    }
}

@page "/reset"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@inherits SsrPage

<PageTitle>Reset password</PageTitle>
<h1>Reset password</h1>

@if (expired)
{
    <p role="alert">This link has expired or was already used.</p>
    <p><a href="/forgot">Request a new link</a></p>
}
else
{
    <form method="post" @onsubmit="Submit" @formname="reset">
        <AntiforgeryToken />
        <div role="alert">@if (error is not null) { <p class="error">@error</p> }</div>
        <input type="hidden" name="Input.Token" value="@Input?.Token" />
        <p>
            <label for="new">New password</label>
            <input id="new" name="Input.New" type="password" autocomplete="new-password" required minlength="8"
                   aria-describedby="@(newError is null ? "new-hint" : "new-hint new-error")" />
            <span id="new-hint" class="hint">At least 8 characters.</span>
            @if (newError is not null) { <span id="new-error" class="error">@newError</span> }
        </p>
        <p>
            <label for="confirm">Confirm password</label>
            <input id="confirm" name="Input.Confirm" type="password" autocomplete="new-password" required
                   aria-describedby="@(confirmError is null ? null : "confirm-error")" />
            @if (confirmError is not null) { <span id="confirm-error" class="error">@confirmError</span> }
        </p>
        <button type="submit">Reset password</button>
    </form>
}

@code {
    [SupplyParameterFromQuery] private string? Token { get; set; }
    [SupplyParameterFromForm(FormName = "reset")] private ResetForm? Input { get; set; }

    private string? error, newError, confirmError;
    private bool expired;

    private sealed class ResetForm
    {
        public string? Token { get; set; }
        public string? New { get; set; }
        public string? Confirm { get; set; }
    }

    protected override void OnInitialized()
    {
        Input ??= new() { Token = Token };
        expired = string.IsNullOrEmpty(Input.Token);
    }

    private async Task Submit()
    {
        var f = Input!;
        if (f.New != f.Confirm) { confirmError = "The passwords do not match."; return; }
        var r = await Api.ResetPassword(f.Token ?? "", f.New ?? "");
        if (r.Ok) { Nav.NavigateTo("/signin?notice=reset"); return; }
        if (await Redirected(r, userScoped: false)) return;
        switch (r.Code)
        {
            case "invalid_token": expired = true; break;
            case "validation": newError = r.Message; break; // the token is not consumed, the form stays usable
            default: error = Describe(r); break;
        }
    }
}

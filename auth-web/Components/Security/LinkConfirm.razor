@inherits ApiComponent

@* The service sends the browser back with ?link_ticket=…; nothing is linked until the user presses "Link account". *@
@if (ticket is not null)
{
    <section aria-labelledby="confirm-h" class="decision">
        <h2 id="confirm-h">Link the account you just signed in to?</h2>
        <p>It will be able to sign in to this account from now on.</p>
        <p class="form-actions">
            <button type="button" class="btn-primary" disabled="@busy" aria-busy="@(busy ? "true" : null)" @onclick="Confirm">Link account</button>
            <button type="button" disabled="@busy" @onclick="Cancel">Cancel</button>
        </p>
    </section>
}
<div role="status">@result</div>

@code {
    [Parameter] public EventCallback OnLinked { get; set; }

    private string? ticket, result;
    private bool busy;

    protected override void OnInitialized() =>
        ticket = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["link_ticket"] is { Length: > 0 } t ? t : null;

    private void Leave()
    {
        ticket = null;
        Nav.NavigateTo("/account/security", replace: true); // the ticket must not stay in the URL
    }

    private void Cancel() => Leave();

    private async Task Confirm()
    {
        // A second click before the first answer would spend the ticket twice and overwrite the result.
        if (busy || ticket is not { } t) return;
        busy = true;
        var r = await Call(s => Api.ConfirmLink(s, t));
        if (r is null) return;
        result = r.Ok ? "Account linked." : r.Code switch
        {
            "forbidden" => "That link was started from a different account, so nothing was changed.",
            "identity_in_use" => "That account is already linked to another user.",
            "invalid_ticket" => "That link request expired. Try again.",
            _ => Describe(r),
        };
        Leave();
        if (r.Ok) await OnLinked.InvokeAsync();
    }
}
